    function toggleRecording() {
      if (!camStream) {
        alert("Kamera belum aktif!");
        return;
      }
      if (isRecording) {
        mediaRecorder.stop();
        isRecording = false;
        recordBtn.textContent = 'Mulai Rekam Video 🎥';
        recordBtn.style.background = 'linear-gradient(90deg,#ffd6d6,#ffebc8)';
      } else {
        recordedChunks = [];
        try {
          mediaRecorder = new MediaRecorder(camStream, { mimeType: 'video/webm' });
        } catch (e) {
          mediaRecorder = new MediaRecorder(camStream);
        }
        mediaRecorder.ondataavailable = event => {
          if (event.data.size > 0) recordedChunks.push(event.data);
        };
        mediaRecorder.onstop = () => {
          const blob = new Blob(recordedChunks, { type: mediaRecorder.mimeType || 'video/webm' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.style.display = 'none';
          a.href = url;
          a.download = `HBD_Video_${Date.now()}.webm`;
          document.body.appendChild(a);
          a.click();
          setTimeout(() => {
            document.body.removeChild(a);
            window.URL.revokeObjectURL(url);
          }, 100);
          scanLoading.textContent = 'Video berhasil disimpan ✅';
        };
        mediaRecorder.start();
        isRecording = true;
        recordBtn.textContent = 'Berhenti Rekam 🛑';
        recordBtn.style.background = '#ff98b8';
      }
    }

